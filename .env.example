# 복사해서 .env 로 쓰세요. .env 는 git 에 올라가지 않습니다.
# 실제 키·비밀번호는 여기(.env.example)가 아니라 .env 에만 넣으세요. 이 파일은 git 에 올라갑니다.

# 서버 포트
PORT=3000

# 저장 방식: json (기본, store/*.json 파일) | mysql (배포용, sql/update.sql 스키마)
STORAGE=json

# MySQL 접속 (STORAGE=mysql 일 때). DATABASE_URL 하나만 쓰거나 MYSQL_* 로 나눠 써도 됩니다.
# 비밀번호에 @ : / 같은 특수문자가 있으면 DATABASE_URL 대신 MYSQL_* 방식을 쓰세요.
# DATABASE_URL=mysql://dgt:비밀번호@127.0.0.1:3306/daily_gaming_tracker
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=dgt
# MYSQL_PASSWORD=비밀번호
# MYSQL_DATABASE=daily_gaming_tracker

# 챗봇 (없으면 검색 안내 모드)
# ANTHROPIC_API_KEY=sk-ant-...
# CHATBOT_MODEL=claude-opus-5-5

# 수집 주기
# PATCH_CHECK_CRON=0 9 * * *
# PATCH_CHECK_TZ=Asia/Seoul
# STEAM_CHECK_CRON=0 */6 * * *
# DISABLE_SCHEDULER=1
